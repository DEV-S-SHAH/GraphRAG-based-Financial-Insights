# ==============================================================================
# Financial GraphRAG: Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL + pgvector Database Configuration ---
# Use 127.0.0.1 on host machines to avoid IPv6 (::1) port forwarding collisions
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=financial_db
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=password123
DATABASE_URL=postgresql://financial_user:password123@127.0.0.1:5432/financial_db
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# --- Neo4j Graph Database Configuration ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_AUTH=neo4j/password123

# --- LLM Configuration ---
# Supported providers: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- API Keys (Optional - leave blank if running purely local with Ollama) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings Configuration ---
# Supported providers: ollama | openai
# Recommended Ollama models:
#   - nomic-embed-text (768 dimensions - fast, lightweight, default)
#   - bge-m3 (1024 dimensions - dense multi-lingual retrieval)
# Recommended OpenAI models:
#   - text-embedding-3-small (1536 dimensions)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Document Ingestion & SEC EDGAR ---
SEC_EDGAR_USER_AGENT=FinancialGraphRAG research@financialgraphrag.local
DATA_RAW_DIR=data/raw/annual_reports
DATA_CHUNKS_DIR=data/chunks
DATA_PROCESSED_DIR=data/processed

# --- Web / Streamlit Application ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
